NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Primary AI Provider (Default: MecutinAI or custom OpenAI-compatible endpoint)
PRIMARY_AI_API_KEY=sk_your_primary_ai_key
PRIMARY_AI_API_ENDPOINT=https://mecutinai.com/api/v1
PRIMARY_AI_MODEL=qwen3.8-flash

# Failover / Backup AI Provider (Default: NVIDIA NIM)
# If primary fails or times out, FINUSA automatically falls over to backup without failing the user
NVIDIA_API_KEY=nvapi-your-nvidia-api-key
NVIDIA_API_ENDPOINT=https://integrate.api.nvidia.com/v1
NVIDIA_API_MODEL=meta/llama-3.2-11b-vision-instruct

# App URL & OAuth Integration
NEXT_PUBLIC_APP_URL=https://finusa.web.id
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Cloudflare Turnstile Anti-Bot Protection
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key

# Admin Privileges (Comma-separated admin emails)
ADMIN_EMAILS=admin@finusa.web.id,your-email@example.com
NEXT_PUBLIC_ADMIN_EMAILS=admin@finusa.web.id,your-email@example.com
