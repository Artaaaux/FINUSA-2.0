NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# NVIDIA NIM Vision & AI Configuration (Get key from build.nvidia.com)
NVIDIA_API_KEY=nvapi-your-nvidia-api-key
NVIDIA_API_ENDPOINT=https://integrate.api.nvidia.com/v1
NVIDIA_API_MODEL=meta/llama-3.2-11b-vision-instruct

# Backup AI Provider (e.g. MecutinAI / OpenRouter / etc.)
# If primary fails or quota runs out, FINUSA automatically falls over to backup
BACKUP_AI_API_KEY=sk_your_backup_ai_key
BACKUP_AI_API_ENDPOINT=https://mecutinai.com/api/v1
BACKUP_AI_MODEL=qwen3.8-flash

# App URL & OAuth Integration
NEXT_PUBLIC_APP_URL=https://finusa.web.id
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Cloudflare Turnstile Anti-Bot Protection
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key
